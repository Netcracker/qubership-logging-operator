{
  "description": "Programmatic supplements for stage-2 migrate grading — run against worktree after migration. Scripts live in the eval workspace, not the published skill.",
  "stage": "migrate",
  "skill_name": "qubership-ndjson-logging-migrate",
  "workspace_scripts": "../qubership-ndjson-logging-migration-workspace/scripts",
  "runtime_evidence_fixtures": {
    "validator": "../qubership-ndjson-logging-migration-workspace/scripts/validate_ndjson_line.py",
    "tests": "../qubership-ndjson-logging-migration-workspace/scripts/test_validate_ndjson_line.py",
    "fixtures": [
      {
        "path": "../qubership-ndjson-logging-migration-workspace/scripts/fixtures/ndjson-runtime/top-level-timestamp.jsonl",
        "expect": "PASS with --require-key resource_id --require-key classifier"
      },
      {
        "path": "../qubership-ndjson-logging-migration-workspace/scripts/fixtures/ndjson-runtime/glued-message.jsonl",
        "expect": "FAIL because required diagnostics remain only in the leading message prefix"
      },
      {
        "path": "../qubership-ndjson-logging-migration-workspace/scripts/fixtures/ndjson-runtime/nested-mdc.jsonl",
        "expect": "FAIL because diagnostics are nested rather than top-level"
      }
    ],
    "scope": "Eval-only. This validates the skill contract; it does not require a deployment eval."
  },
  "checks": [
    {
      "eval_id": 1,
      "eval_name": "go-log-exporter",
      "worktree_subpath": "",
      "script": "../qubership-ndjson-logging-migration-workspace/scripts/check_migration_gates.py",
      "args": ["{worktree}", "--go-path", "."],
      "grep_expectations": {
        "active_logf_production": 0
      }
    },
    {
      "eval_id": 2,
      "eval_name": "java-dbaas-monorepo",
      "components": [
        {
          "name": "dbaas-aggregator",
          "script": "../qubership-ndjson-logging-migration-workspace/scripts/check_migration_gates.py",
          "args": ["{worktree}", "--java-path", "dbaas/dbaas-aggregator", "--go-path", "dbaas-operator"]
        }
      ],
      "grep_expectations": {
        "java_brace_interpolation": 0,
        "java_argn_keys": 0,
        "go_active_logf_production": 0
      },
      "ledger_expectations": [
        "dbaas-aggregator listed",
        "dbaas-operator listed"
      ]
    }
  ]
}
