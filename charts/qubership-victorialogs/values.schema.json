{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qubership VictoriaLogs chart values",
  "description": "Validation schema for the standalone Qubership VictoriaLogs Helm chart.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "CLOUD_PUBLIC_HOST": {
      "description": "Public DNS suffix used to generate external hosts when explicit hosts are not set.",
      "type": "string"
    },
    "labels": {
      "description": "Labels applied to all VictoriaLogs and VMAuth resources.",
      "type": "object"
    },
    "annotations": {
      "description": "Annotations applied to VictoriaLogs and VMAuth workloads.",
      "type": "object"
    },
    "victorialogs": {
      "description": "Standalone single-node VictoriaLogs deployment configuration.",
      "properties": {
        "affinity": {
          "description": "Pod scheduling constraints.",
          "type": "object"
        },
        "addIngressIgnoreAnnotation": {
          "description": "Add an ignore annotation to Ingress when HTTPRoute is enabled to prevent duplicate route conversion.",
          "type": "boolean"
        },
        "annotations": {
          "description": "Annotations for VictoriaLogs resources.",
          "type": "object"
        },
        "dashboard": {
          "description": "Grafana Operator dashboard configuration.",
          "properties": {
            "allowCrossNamespaceImport": {
              "description": "Allow the dashboard to target a Grafana instance in another namespace.",
              "type": "boolean"
            },
            "annotations": {
              "type": "object"
            },
            "install": {
              "type": "boolean"
            },
            "instanceSelector": {
              "description": "Label selector for the Grafana v5 instance that imports the dashboard.",
              "properties": {
                "matchExpressions": {
                  "items": {
                    "type": "object"
                  },
                  "type": "array"
                },
                "matchLabels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              },
              "type": "object",
              "additionalProperties": false
            },
            "labels": {
              "type": "object"
            }
          },
          "required": [
            "instanceSelector"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "dockerImage": {
          "description": "VictoriaLogs container image.",
          "type": "string"
        },
        "env": {
          "description": "Additional non-sensitive environment variables for the VictoriaLogs container.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "envFrom": {
          "description": "Sources for additional non-sensitive VictoriaLogs environment variables.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "extraArgs": {
          "additionalProperties": {
            "type": [
              "boolean",
              "integer",
              "number",
              "string"
            ]
          },
          "description": "Additional VictoriaLogs command-line arguments.",
          "type": "object"
        },
        "extraVolumeMounts": {
          "description": "Additional VictoriaLogs volume mounts.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "extraVolumes": {
          "description": "Additional Pod volumes.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "imagePullPolicy": {
          "description": "Image pull policy for the VictoriaLogs container.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "imagePullSecrets": {
          "description": "Image pull secrets for the VictoriaLogs Pod.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "httpRoute": {
          "description": "Gateway API HTTPRoute configuration.",
          "properties": {
            "annotations": {
              "type": "object"
            },
            "hostnames": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "install": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "parentRefs": {
              "items": {
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        "ingress": {
          "description": "Kubernetes Ingress configuration.",
          "properties": {
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "host"
                ],
                "properties": {
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pathType": {
                          "type": "string",
                          "enum": [
                            "Exact",
                            "ImplementationSpecific",
                            "Prefix"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "type": "array"
            },
            "ingressClassName": {
              "type": "string"
            },
            "install": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "tls": {
              "items": {
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        "install": {
          "description": "Deploy VictoriaLogs resources.",
          "type": "boolean"
        },
        "labels": {
          "description": "Labels for VictoriaLogs resources.",
          "type": "object"
        },
        "livenessProbe": {
          "description": "Liveness probe configuration.",
          "type": "object"
        },
        "nameOverride": {
          "description": "Override the VictoriaLogs resource name.",
          "type": "string"
        },
        "nodeSelector": {
          "description": "Node selector for the VictoriaLogs Pod.",
          "type": "object"
        },
        "podAnnotations": {
          "description": "Annotations for the VictoriaLogs Pod.",
          "type": "object"
        },
        "podLabels": {
          "description": "Labels for the VictoriaLogs Pod.",
          "type": "object"
        },
        "podManagementPolicy": {
          "description": "Pod creation order for the VictoriaLogs StatefulSet.",
          "enum": [
            "OrderedReady",
            "Parallel"
          ],
          "type": "string"
        },
        "podSecurityContext": {
          "description": "Security context for the VictoriaLogs Pod.",
          "type": "object"
        },
        "port": {
          "description": "HTTP listen port exposed by the VictoriaLogs container.",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "priorityClassName": {
          "description": "PriorityClass assigned to the VictoriaLogs Pod.",
          "type": "string"
        },
        "readinessProbe": {
          "description": "Readiness probe configuration.",
          "type": "object"
        },
        "resources": {
          "description": "Compute resources for the VictoriaLogs container.",
          "type": "object"
        },
        "retentionPeriod": {
          "description": "VictoriaLogs data retention period. Supported units are h, d, w, and y; a value without a unit means months.",
          "type": [
            "integer",
            "string"
          ]
        },
        "securityContext": {
          "description": "Security context for the VictoriaLogs container.",
          "type": "object"
        },
        "tmpVolume": {
          "description": "Temporary volume configuration for VictoriaLogs.",
          "properties": {
            "sizeLimit": {
              "description": "Maximum capacity of the VictoriaLogs /tmp volume.",
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        "service": {
          "description": "VictoriaLogs Service configuration.",
          "properties": {
            "annotations": {
              "type": "object"
            },
            "labels": {
              "type": "object"
            },
            "port": {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        "serviceMonitor": {
          "description": "Prometheus Operator ServiceMonitor configuration.",
          "properties": {
            "annotations": {
              "type": "object"
            },
            "install": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "metricRelabelings": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "relabelings": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "scrapeInterval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        "startupProbe": {
          "description": "Startup probe configuration.",
          "type": "object"
        },
        "storage": {
          "description": "VictoriaLogs data storage configuration.",
          "properties": {
            "accessModes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "annotations": {
              "type": "object"
            },
            "existingClaim": {
              "description": "Mount this PVC instead of creating one.",
              "type": "string"
            },
            "labels": {
              "type": "object"
            },
            "mountPath": {
              "type": "string"
            },
            "persistentVolume": {
              "type": "string"
            },
            "size": {
              "description": "Requested capacity for the generated PVC.",
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            },
            "subPath": {
              "type": "string"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        "terminationGracePeriodSeconds": {
          "minimum": 0,
          "type": "integer"
        },
        "tolerations": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "topologySpreadConstraints": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "updateStrategy": {
          "description": "Update strategy for the VictoriaLogs StatefulSet.",
          "type": "object"
        },
        "vmauth": {
          "description": "VMAuth proxy configuration for external VictoriaLogs access.",
          "properties": {
            "affinity": {
              "description": "Pod scheduling constraints.",
              "type": "object"
            },
            "annotations": {
              "description": "Annotations for the VMAuth Deployment.",
              "type": "object"
            },
            "config": {
              "description": "Native VMAuth configuration stored in a Kubernetes Secret and mounted read-only. The unauthorized_user section is not allowed.",
              "properties": {
                "users": {
                  "items": {
                    "description": "Authenticated VMAuth user. Define exactly one authentication method: non-empty username and password, or non-empty bearer_token.",
                    "oneOf": [
                      {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "bearer_token"
                              ]
                            },
                            {
                              "required": [
                                "auth_token"
                              ]
                            },
                            {
                              "required": [
                                "jwt"
                              ]
                            }
                          ]
                        },
                        "required": [
                          "username",
                          "password"
                        ]
                      },
                      {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "username"
                              ]
                            },
                            {
                              "required": [
                                "password"
                              ]
                            },
                            {
                              "required": [
                                "auth_token"
                              ]
                            },
                            {
                              "required": [
                                "jwt"
                              ]
                            }
                          ]
                        },
                        "required": [
                          "bearer_token"
                        ]
                      }
                    ],
                    "properties": {
                      "bearer_token": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "password": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "username": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "dockerImage": {
              "description": "VMAuth container image.",
              "type": "string"
            },
            "env": {
              "description": "Additional non-sensitive environment variables for the VMAuth container.",
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "envFrom": {
              "description": "Sources for additional non-sensitive VMAuth environment variables.",
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "extraArgs": {
              "additionalProperties": {
                "type": [
                  "boolean",
                  "integer",
                  "number",
                  "string"
                ]
              },
              "description": "Additional VMAuth command-line arguments.",
              "type": "object"
            },
            "extraVolumeMounts": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "extraVolumes": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "imagePullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ],
              "type": "string"
            },
            "imagePullSecrets": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "livenessProbe": {
              "type": "object"
            },
            "nodeSelector": {
              "type": "object"
            },
            "podAnnotations": {
              "type": "object"
            },
            "podLabels": {
              "type": "object"
            },
            "podSecurityContext": {
              "type": "object"
            },
            "port": {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            "priorityClassName": {
              "type": "string"
            },
            "readinessProbe": {
              "type": "object"
            },
            "replicaCount": {
              "minimum": 1,
              "type": "integer"
            },
            "resources": {
              "type": "object"
            },
            "securityContext": {
              "type": "object"
            },
            "tmpVolume": {
              "description": "Temporary volume configuration for VMAuth.",
              "properties": {
                "sizeLimit": {
                  "description": "Maximum capacity of the VMAuth /tmp volume.",
                  "minLength": 1,
                  "type": "string"
                }
              },
              "type": "object",
              "additionalProperties": false
            },
            "service": {
              "properties": {
                "annotations": {
                  "type": "object"
                },
                "labels": {
                  "type": "object"
                },
                "port": {
                  "maximum": 65535,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "type": "object",
              "additionalProperties": false
            },
            "startupProbe": {
              "type": "object"
            },
            "terminationGracePeriodSeconds": {
              "minimum": 0,
              "type": "integer"
            },
            "tolerations": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "topologySpreadConstraints": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "existingSecret": {
              "description": "Name of an existing Secret that contains the VMAuth configuration.",
              "type": "string"
            },
            "existingSecretKey": {
              "description": "Key in the existing Secret that contains the VMAuth configuration.",
              "type": "string",
              "minLength": 1
            }
          },
          "type": "object",
          "additionalProperties": false
        }
      },
      "type": "object",
      "additionalProperties": false
    }
  }
}
