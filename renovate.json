{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:go",
    "github>Netcracker/renovate-config:netcracker-dependencies",
    "github>Netcracker/renovate-config:annotated-versions"
  ],
  "prConcurrentLimit": 20,
  "ignorePaths": [
    "deploy/kind/helmfile.yaml.gotmpl"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "Netcracker/qubership-opensearch",
        "ghcr.io/netcracker/qubership-opensearch-operator",
        "kubernetes-sigs/kind"
      ],
      "groupName": "integration-tests",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "Netcracker/qubership-fluentd",
        "Netcracker/qubership-kube-events-reader",
        "Netcracker/qubership-graylog-plugins-init",
        "Netcracker/qubership-graylog-auth-proxy"
      ],
      "ignoreUnstable": false,
      "groupName": "netcracker-deps"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["graylog/graylog"],
      "matchCurrentVersion": "/^5\\./",
      "allowedVersions": ">=5.0.0 <6.0.0"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["mongo"],
      "matchCurrentVersion": "/^5\\./",
      "allowedVersions": ">=5.0.0 <6.0.0"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["mongo"],
      "matchCurrentVersion": "/^4\\.0\\./",
      "allowedVersions": ">=4.0.0 <4.1.0"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["mongo"],
      "matchCurrentVersion": "/^4\\.2\\./",
      "allowedVersions": ">=4.2.0 <4.3.0"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["mongo"],
      "matchCurrentVersion": "/^4\\.4\\./",
      "allowedVersions": ">=4.4.0 <4.5.0"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "graylog/graylog",
        "jimmidyson/configmap-reload",
        "fluent/fluent-bit",
        "mongo",
        "alpine"
      ],
      "groupName": "third-party-images"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker-deps",
      "matchFileNames": [
        "Dockerfile"
      ],
      "matchPackageNames": [
        "!golang",
        "!docker.io/library/golang",
        "!index.docker.io/library/golang",
        "!registry-1.docker.io/library/golang"
      ]
    }
  ],
  "platformAutomerge": true
}
